# Production is managed infrastructure. Inject values through Render/ECS/Fly
# secret management; never commit a filled copy of this template.
APP_NAME=AI Operations Compliance API
ENVIRONMENT=production
AUTH_PROVIDER=oidc_jwt
ALLOW_DEVELOPMENT_IDENTITY=false
SESSION_TTL_MINUTES=480
DATABASE_URL=<secret-manager:production-database-url>
ALLOWED_ORIGINS=https://app.example.example
REQUIRED_CERTIFICATE_HOLDER=replace-with-customer-policy
MINIMUM_GL_OCCURRENCE_LIMIT=2000000
RULES_VERSION=rules.v1
MAX_UPLOAD_BYTES=10485760
VAULT_KEK_BASE64=<secret-manager:production-vault-kek-base64>
VAULT_KEY_VERSION=production-kms-v1
CONNECTOR_EGRESS_ALLOWLIST=customer-approved-hosts-only
OTEL_EXPORTER_OTLP_ENDPOINT=<secret-manager:production-otel-endpoint>
LANGFUSE_HOST=<secret-manager:production-langfuse-host>
LANGFUSE_OTEL_ENDPOINT=<secret-manager:production-langfuse-otel-endpoint>
LANGFUSE_PUBLIC_KEY=<secret-manager:production-langfuse-public-key>
LANGFUSE_SECRET_KEY=<secret-manager:production-langfuse-secret-key>
SENTRY_DSN=<secret-manager:production-sentry-dsn>
VALUE_INFRA_COST_PER_RUN_USD=0
NEXT_PUBLIC_API_BASE_URL=https://api.example.example
NEXT_PUBLIC_AUTH_MODE=provider
NEXT_PUBLIC_ALLOW_DEVELOPMENT_AUTH=false
