# Staging is production-like. Inject every value through the deployment secret
# manager or CI environment; this file contains no usable credentials.
APP_NAME=AI Operations Compliance API
ENVIRONMENT=staging
AUTH_PROVIDER=oidc_jwt
ALLOW_DEVELOPMENT_IDENTITY=false
SESSION_TTL_MINUTES=480
DATABASE_URL=<secret-manager:staging-database-url>
ALLOWED_ORIGINS=https://staging.example.example
REQUIRED_CERTIFICATE_HOLDER=replace-with-customer-policy
MINIMUM_GL_OCCURRENCE_LIMIT=2000000
RULES_VERSION=rules.v1
MAX_UPLOAD_BYTES=10485760
VAULT_KEK_BASE64=<secret-manager:staging-vault-kek-base64>
VAULT_KEY_VERSION=staging-kms-v1
CONNECTOR_EGRESS_ALLOWLIST=sandbox.local,mcp.local,rest.local
OTEL_EXPORTER_OTLP_ENDPOINT=<secret-manager:staging-otel-endpoint>
LANGFUSE_HOST=<secret-manager:staging-langfuse-host>
LANGFUSE_OTEL_ENDPOINT=<secret-manager:staging-langfuse-otel-endpoint>
LANGFUSE_PUBLIC_KEY=<secret-manager:staging-langfuse-public-key>
LANGFUSE_SECRET_KEY=<secret-manager:staging-langfuse-secret-key>
SENTRY_DSN=<secret-manager:staging-sentry-dsn>
VALUE_INFRA_COST_PER_RUN_USD=0
NEXT_PUBLIC_API_BASE_URL=https://staging-api.example.example
NEXT_PUBLIC_AUTH_MODE=provider
NEXT_PUBLIC_ALLOW_DEVELOPMENT_AUTH=false
