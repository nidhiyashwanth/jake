APP_NAME=AI Operations Compliance API
ENVIRONMENT=development
AUTH_PROVIDER=development
ALLOW_DEVELOPMENT_IDENTITY=true
SESSION_TTL_MINUTES=480
POSTGRES_USER=replace-with-local-user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=replace-with-local-db
POSTGRES_PORT=15432
POSTGRES_VOLUME_NAME=ai-ops-platform-ledger-data
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=postgresql+psycopg://replace-with-local-user:replace-with-local-password@localhost:15432/replace-with-local-db
ALLOWED_ORIGINS=http://localhost:3000
REQUIRED_CERTIFICATE_HOLDER=Northwind Construction LLC
MINIMUM_GL_OCCURRENCE_LIMIT=2000000
RULES_VERSION=rules.v1
MAX_UPLOAD_BYTES=10485760
VAULT_KEK_BASE64=
VAULT_KEY_VERSION=deployment-kms-v1
CONNECTOR_EGRESS_ALLOWLIST=localhost,sandbox.local,mcp.local,rest.local
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_OTEL_ENDPOINT=
